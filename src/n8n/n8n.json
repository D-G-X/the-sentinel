    {
      "parameters": {
        "jsCode": "const files = items\n  .map(item => item.json)\n  .filter(f => f.patch)\n  .map(f => ({\n    filename: f.filename,\n    patch: f.patch, // ✅ changed from diff → patch\n    text: `File: ${f.filename}\\nPatch:\\n${f.patch}` // optional: updated label too\n  }));\n\nreturn [\n  {\n    json: {\n      files,\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -704,
        0
      ],
      "id": "1481e400-55b0-4785-adae-74dd4d5b3c79",
      "name": "PR Files"
    },
    {
      "parameters": {
        "jsCode": "// Decode architecture.json from GitHub\nconst fileContentBase64 = $json.content;\nconst archJson = JSON.parse(Buffer.from(fileContentBase64, 'base64').toString('utf8'));\n\nreturn [\n  {\n    json: {\n      architecture: archJson\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -272,
        0
      ],
      "id": "7b4c86e8-6f5a-4b33-914e-71c6b5186297",
      "name": "Arch JSON"
    },
    {
      "parameters": {
        "jsCode": "// Get nodes\nconst prFilesNode = $node[\"PR Files\"];\nconst archJsonNode = $node[\"Arch JSON\"];\n\nif (!prFilesNode || !archJsonNode) {\n    throw new Error(\"Missing nodes\");\n}\n\n// Extract data\nconst prFiles = prFilesNode.json.files;\nconst architecture = archJsonNode.json.architecture;\n\nconst codeText = prFiles\n  .map(f => `File: ${f.filename}\\nPatch:\\n${f.patch}`) // ✅ diff → patch\n  .join(\"\\n\\n\");\n\nreturn [\n  {\n    json: {\n      // code: codeText,\n      prFiles,\n      architectRules: architecture\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
